# Copy to .env and fill in. Never commit .env.

# --- Gnani ---
GNANI_API_KEY=your_gnani_api_key
GNANI_BASE_URL=https://api.vachana.ai

# STT: prisma-v3.0 = auto language detection (multilingual). Leave empty for default v2.5 + STT_DEFAULT_LANGUAGE.
STT_MODEL=prisma-v3.0
STT_DEFAULT_LANGUAGE=hi-IN

# TTS: take the exact Timbre v2.5 model string and voice names from the Gnani TTS docs / Available Voices page
TTS_MODEL=
TTS_VOICE_HI=sia
TTS_VOICE_MR=
TTS_VOICE_EN=
TTS_SAMPLE_RATE=44100

# --- Evon (self-hosted, OpenAI-compatible) ---
EVON_ENABLED=true
EVON_BASE_URL=http://localhost:8001
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_API_KEY=

# --- Market ---
MARKET_SOURCE=yfinance        # yfinance | sample

# --- App ---
DB_PATH=data/munimji.db
AUDIO_TTL_MIN=30
MAX_AUDIO_SECONDS=20
CONFIRM_AMOUNT_RUPEES=5000
DEBUG=true
CORS_ORIGINS=http://localhost:8000
API_TOKEN=
