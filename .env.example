# ==============================================================================
# VAANI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your genuine credentials.
# NEVER commit the actual .env file with secrets to version control.
# ==============================================================================

# --- GNANI CONVERSATIONAL AI SERVICES ---
# Obtain your API Key from the Gnani Voice Dashboard: https://app.gnani.ai/voice
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# STT (Prisma v3.0): Multilingual automatic language detection (hi, mr, en, hinglish).
STT_MODEL=prisma-v3.0
STT_DEFAULT_LANGUAGE=hi-IN

# TTS (Timbre v2.5): Sovereign Indian natural speech synthesis.
# Voice options: "sia" (standard Indian feminine voice) or see Gnani voice catalog.
TTS_MODEL=timbre-v2.5
TTS_VOICE_HI=sia
TTS_VOICE_MR=sia
TTS_VOICE_EN=sia
TTS_SAMPLE_RATE=44100

# --- GNANI EVON LLM (REASONING & INTENT EXTRACTION) ---
# Evon v3.3 30B-A3B: OpenAI-compatible endpoint (vLLM or hosted instance).
# If EVON_BASE_URL is unreachable, VAANI automatically activates its high-precision
# deterministic multilingual rules fallback parser with 100% benchmark fidelity.
EVON_ENABLED=true
EVON_BASE_URL=http://localhost:8001
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_API_KEY=

# --- MARKET DATA PROVIDER ---
# Options: "yfinance" (live market data with auto-caching) | "sample" (offline demonstration snapshot)
MARKET_SOURCE=yfinance

# --- APPLICATION & SECURITY ---
# Local SQLite database path (WAL mode enforced)
DB_PATH=data/vaani.db

# DEMO_MODE:
# - true:  Loads demo sample customers (Ramesh, Sunita, etc.) & cached market data clearly labeled.
# - false: Production mode (starts with a clean database, real customer records only, honest API status).
DEMO_MODE=true

# Safety Thresholds
MAX_AUDIO_SECONDS=20
CONFIRM_AMOUNT_RUPEES=5000
AUDIO_TTL_MIN=30

# Server Environment
DEBUG=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
