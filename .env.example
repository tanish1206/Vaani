# ==============================================================================
# VAANI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your Gnani credentials when ready.
# NEVER commit the actual .env file with live secrets to version control.
# ==============================================================================

# --- GNANI VOICE AI CONFIGURATION ---
# Obtain your API Key from the official Gnani Voice Dashboard: https://app.gnani.ai/voice
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_ASR_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_VOICE_LIST_ENDPOINT=
GNANI_MODEL=prisma-v3.0
GNANI_DEFAULT_VOICE_ID=sia

# --- CONVERSATIONAL REASONING PROVIDER ---
# Optional self-hosted Evon v3.3 30B-A3B OpenAI-compatible endpoint.
# When unconfigured, VAANI's deterministic parser handles intents and safety guardrails.
EVON_ENABLED=true
EVON_BASE_URL=http://localhost:8001
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_API_KEY=

# --- MARKET DATA PROVIDER ---
# Live market data provider ("yfinance"). If unconfigured or unreachable,
# Sensex Awaaz presents an honest unavailable state (never fabricated numbers).
MARKET_SOURCE=yfinance

# --- APPLICATION, DATABASE & SECURITY ---
# Local SQLite database path (WAL mode enforced, zero demo records)
DB_PATH=data/vaani.db
DEMO_MODE=false
DEBUG=false

# Safety & Audio Limits
MAX_AUDIO_SECONDS=20
CONFIRM_AMOUNT_RUPEES=5000
AUDIO_TTL_MIN=30
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
