# ==============================================================================
# VAANI — OFFICIAL GNANI SPEECH API INTEGRATION CONFIGURATION
# Copy this file to .env and insert your Gnani credentials.
# Keep API keys exclusively on the backend. Never expose in frontend/HTML/JS.
# ==============================================================================

# --- OFFICIAL GNANI SPEECH APIS ---
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_ASR_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_WS_ASR_ENDPOINT=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_SSE_ENDPOINT=https://api.vachana.ai/api/v1/tts/sse

GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_DEFAULT_VOICE=Shivani
GNANI_DEFAULT_LANGUAGE=auto

# --- CONVERSATIONAL REASONING PROVIDER ---
# Optional self-hosted Evon v3.3 30B-A3B OpenAI-compatible endpoint.
# When unconfigured, VAANI's deterministic parser handles intents and safety guardrails.
EVON_ENABLED=true
EVON_BASE_URL=http://localhost:8001
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_API_KEY=

# --- MARKET DATA PROVIDER ---
MARKET_SOURCE=yfinance

# --- APPLICATION & DATABASE (LOCAL SOVEREIGNTY) ---
DB_PATH=data/vaani.db
DEMO_MODE=false
DEBUG=false

# Safety & Audio Limits
MAX_AUDIO_SECONDS=20
CONFIRM_AMOUNT_RUPEES=5000
AUDIO_TTL_MIN=30
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
